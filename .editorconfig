# Editor Configuration
# Page: https://editorconfig.org

# Configuracion Raiz
root = true

# Configuracion Global
[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
max_line_lenght = 120
trim_trailing_whitespace = true





# Reglas Varios Archivos
[*.{css,html,js,ts}]
indent_size = 2
indent_style = space
trim_trailing_whitespace = true

# Reglas Archivos CSS
[*.css]
indent_size = 2
indent_style = space
trim_trailing_whitespace = true

# Reglas Archivos HTML
[*.html]
indent_size = 2
indent_style = space
trim_trailing_whitespace = true

# Reglas Archivos JavaScript
[*.js]
indent_size = 2
indent_style = space
trim_trailing_whitespace = true

# Reglas Archivos JSON
[*.{json,jsonc}]
indent_size = 2
indent_style = space
trim_trailing_whitespace = true

# Reglas Archivos TypeScript
[*.ts]
indent_size = 2
indent_style = space
quote_type = single
trim_trailing_whitespace = true

# Reglas Archivos MD
[*.md]
indent_size = 2
indent_style = space
max_line_length = off
trim_trailing_whitespace = false





# Reglas Varios Archivos
[*.{php,java}]
indent_size = 4
indent_style = space
trim_trailing_whitespace = true

# Reglas Archivos PHP
[*.php]
indent_size = 4
indent_style = space
trim_trailing_whitespace = true

# Reglas Archivos Java
[*.java]
indent_size = 4
indent_style = space
trim_trailing_whitespace = true





# Reglas Varios Archivos
[*.{xml,yaml,yml}]
indent_size = 2
indent_style = space
trim_trailing_whitespace = true

# Reglas Archivos XML
[*.xml]
indent_size = 2
indent_style = space
max_line_length = 0

# Reglas Archivos YAML
[*.yaml]
indent_size = 2
indent_style = space
max_line_length = 80

# Reglas Archivos YML
[*.yml]
indent_size = 2
indent_style = space
max_line_length = 80





# Reglas Archivos htaccess
[.htaccess]
charset = utf-8
insert_final_newline = false
trim_trailing_whitespace = false
